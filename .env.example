# Copy to .env before `docker compose up`.

# REQUIRED. Signs the admin session cookie. Generate a fresh one:
#   openssl rand -hex 32
# The API refuses to start with an empty or sample value when cookies are
# secure, rather than issuing sessions anyone could forge.
IV_JWT_SECRET=

# Host port nginx binds to directly. Bypassed once you run with --profile
# tls below, but left open for direct/debug access either way.
IV_HTTP_PORT=8080

# Set false ONLY for local http development — cookies are Secure otherwise.
IV_COOKIE_SECURE=true

# --- Only needed for `docker compose --profile tls up -d` -----------------
# Adds a caddy service on 80/443 that gets a free auto-renewing Let's
# Encrypt cert. DNS A record for the domain must already point here.

# Domain the caddy service issues a TLS cert for (also covers www.<domain>).
IV_DOMAIN=

# Email Let's Encrypt uses for cert expiry/revocation notices.
IV_ACME_EMAIL=

# Optional private git remote for off-site content backup, e.g.
#   git@github.com:you/iv-content.git
# The API pushes after each save on a best-effort basis; the nightly cron
# (`python -m app.cli backup`) is the real guarantee.
IV_BACKUP_REMOTE=

# Days a soft-deleted message stays in Trash before `app.cli purge` removes it.
IV_TRASH_RETENTION_DAYS=30

# --- AI Studio (unrelated to the CMS; kept from the original template) ------

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
