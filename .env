# Local environment for `docker compose up`.
# Git-ignored — never commit this file.

# Signs the admin session cookie. Generated with a cryptographic RNG.
# Changing it invalidates everyone's session; that is the correct response
# if you ever think it has leaked.
IV_JWT_SECRET=b6785f1c96ebe9dad95e1cd00b546b48b87eec821f13a4a31bafe8760d90aa66

# Host port nginx binds to -> http://localhost:8080
IV_HTTP_PORT=8080

# FALSE for local http testing only.
# A Secure cookie is refused by the browser over plain http://localhost, so
# login would appear to succeed and then drop you straight back to the sign-in
# screen. Set this to true as soon as the real domain is behind HTTPS.
IV_COOKIE_SECURE=false

# Optional private git remote for off-site content backup, e.g.
#   git@github.com:shefo90/iv-content.git
# Leave empty until you have created that repo. The API pushes after each save
# on a best-effort basis; `app.cli backup` on a nightly cron is the real
# guarantee.
IV_BACKUP_REMOTE=

# Days a deleted message stays in Trash before `app.cli purge` removes it.
IV_TRASH_RETENTION_DAYS=30
